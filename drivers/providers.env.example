# OrgSmith bring-your-own-token authoring config (EXAMPLE).
#
# Copy to ~/.config/orgsmith/providers.env and uncomment the block for the
# provider you want. Every line here is commented, so this file turns nothing
# on. The real file lives OUTSIDE the repository so a key can never be
# committed; `providers.env` is also gitignored as defense in depth.
#
# Override the path with ORGSMITH_PROVIDERS_ENV (mainly for tests).
# A value already exported in your shell wins over this file.
#
# Check what is configured, without spending a token:
#   python -m drivers.forge_external --check

# --- select the active provider (unset = BYO mode off) --------------------
# ORGSMITH_AUTHOR_PROVIDER=openai        # openai | anthropic | google | openrouter | local
# ORGSMITH_AUTHOR_EFFORT=high            # stamped into the generator record (advisory)
# ORGSMITH_AUTHOR_MODEL=                 # optional global model override (else per-provider default)

# --- OpenAI ---------------------------------------------------------------
# OPENAI_API_KEY=sk-...
# ORGSMITH_OPENAI_MODEL=gpt-4o
# ORGSMITH_OPENAI_BASE_URL=https://api.openai.com/v1

# --- Anthropic ------------------------------------------------------------
# ANTHROPIC_API_KEY=sk-ant-...
# ORGSMITH_ANTHROPIC_MODEL=claude-sonnet-5
# ORGSMITH_ANTHROPIC_BASE_URL=https://api.anthropic.com/v1

# --- Google (Gemini, via its OpenAI-compatible endpoint) ------------------
# GOOGLE_API_KEY=...
# ORGSMITH_GOOGLE_MODEL=gemini-2.5-pro
# ORGSMITH_GOOGLE_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai

# --- OpenRouter -----------------------------------------------------------
# OPENROUTER_API_KEY=sk-or-...
# ORGSMITH_OPENROUTER_MODEL=openai/gpt-4o
# ORGSMITH_OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# --- local / generic OpenAI-compatible ------------------------------------
# Any OpenAI-compatible host: Ollama, LM Studio, vLLM, or a hosted gateway
# for xAI / DeepSeek / Mistral / Together / Groq. Key is optional for local
# servers; required by most hosted ones.
# ORGSMITH_LOCAL_BASE_URL=http://localhost:11434/v1
# ORGSMITH_LOCAL_MODEL=qwen2.5-coder:32b
# ORGSMITH_LOCAL_API_KEY=
