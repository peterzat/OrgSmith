          "title": "Ndcg At 10",
          "type": "number"
        },
        "precision": {
          "title": "Precision",
          "type": "number"
        },
        "questions": {
          "title": "Questions",
          "type": "integer"
        },
        "recall": {
          "title": "Recall",
          "type": "number"
        },
        "recall_at_10": {
          "title": "Recall At 10",
          "type": "number"
        },
        "recall_at_5": {
          "title": "Recall At 5",
          "type": "number"
        },
        "retriever": {
          "title": "Retriever",
          "type": "string"
